# Variables de entorno del Sistema Plenario FECh
#
# En Vercel se cargan en Project Settings → Environment Variables.
# Copia este archivo sólo como referencia local; nunca subas valores reales.

# ─── Obligatorias ────────────────────────────────────────────────────────────

# Cadena de conexión a PostgreSQL.
# Usa el pooler de transacciones de Supabase para la aplicación en Vercel.
DATABASE_URL=postgresql://usuario:clave@host:5432/basededatos

# UUID de la institución atendida por este despliegue. Permite compartir una
# base Supabase sin compartir filas entre instituciones.
INSTITUTION_ID=00000000-0000-4000-8000-000000000001

# Clave para firmar las sesiones de inicio de sesión.
# Cualquier texto largo y aleatorio. NO la compartas ni la subas al repositorio.
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Puerto de la API. Si se omite: API 3001 y frontend 5173.
# En Replit configura PORT=5000 como antes. No uses el mismo puerto para ambos
# servidores locales; configura sus entornos por separado.
# PORT=3001

# Prefijo de rutas del frontend. En una instalación normal es la raíz.
BASE_PATH=/

# ─── Opcionales ──────────────────────────────────────────────────────────────

# development | production
NODE_ENV=development

# URL pública exacta: obligatoria en producción para solicitudes y tiempo real.
# Sin comodines. No se confía en Host ni X-Forwarded-Host para autorizar orígenes.
# APP_URL=https://tu-proyecto.vercel.app
# Orígenes adicionales explícitos, separados por comas, si fueran necesarios.
# ALLOWED_ORIGINS=https://otro-dominio.example
# URL del proyecto y clave de servicio, solo en la API de Vercel.
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=secreto-del-servidor
# SUPABASE_STORAGE_BUCKET=plenario-actas
# En desarrollo se permiten orígenes localhost/127.0.0.1; en producción no.
# Para probar consultas REST periódicas sin servidor Socket.IO persistente:
# VITE_REALTIME_TRANSPORT=polling
# Los builds de Vercel fuerzan este modo. Ver docs/vercel.md antes de publicar.

# error | warn | info | debug
LOG_LEVEL=info

# Solo integración local: base dedicada, nombre terminado en _test.
# NODE_ENV=test nunca utiliza DATABASE_URL como respaldo.
# TEST_DATABASE_URL=postgresql://usuario:clave@127.0.0.1:5432/plenario_test

# Proxy de desarrollo Vite (no es una variable secreta).
# API_PROXY_TARGET=http://127.0.0.1:3001

# Máximo de conexiones por instancia serverless; 5 es el valor productivo.
# DB_POOL_MAX=5

# ─── Bootstrap inicial (sólo al ejecutar `pnpm --filter @workspace/scripts seed`) ───
# BOOTSTRAP_INSTITUTION_ID=00000000-0000-4000-8000-000000000001
# BOOTSTRAP_INSTITUTION_SLUG=fech
# BOOTSTRAP_INSTITUTION_NAME=Federación de Estudiantes
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_DISPLAY_NAME=Administración
# BOOTSTRAP_ADMIN_PASSWORD=una-clave-larga-y-unica
